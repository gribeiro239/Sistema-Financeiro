{
  "Database": {
    "Provider": "SQLite",
    "File": "App_Data/finance.db"
  },
  "Backups": {
    "Enabled": true,
    "Directory": "App_Data/Backups",
    "KeyFile": "App_Data/Backup-Key.key",
    "IntervalHours": 24,
    "RetentionCount": 14,
    "MaxArchiveMegabytes": 512
  },
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "StartTls": true,
    "FromAddress": "",
    "FromName": "Nexo Financeiro",
    "PublicUrl": "http://localhost:5173"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
